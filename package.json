{
  "name": "onesend-be",
  "module": "apps/rest/index.ts",
  "type": "module",
  "scripts": {
    "start:dev": "export $(cat .env.develop | xargs) && export NODE_ENV=development && bun run prisma:generate && bun --watch apps/rest/index.ts",
    "build:prod": "export $(cat .env | xargs) && export NODE_ENV=production &&bun run prisma:generate && bun build apps/rest/index.ts  --outdir build --target bun --sourcemap --minify",
    "test": "export $(cat .env.test | xargs) && bun test --preload apps/rest/tests/setup.ts --coverage",
    "prisma:generate": "export $(cat .env | xargs) && prisma generate --schema apps/shared/database/schema.prisma",
    "prisma:format": "prisma format --schema apps/shared/database/schema.prisma",
    "prisma:pull": "export $(cat .env.develop | xargs) && prisma db pull --schema apps/shared/database/schema.prisma",
    "prisma:migrade:dev": "export $(cat .env.develop | xargs) && prisma migrate dev --schema apps/shared/database/schema.prisma"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/nodemailer": "^6.4.14",
    "@types/uuid": "^9.0.7",
    "bun-types": "latest",
    "prettier": "^3.1.0"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@prisma/client": "5.6.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/cookie-session": "^2.0.49",
    "@types/express-session": "^1.18.0",
    "@types/lodash": "^4.17.7",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth2": "^0.1.8",
    "@types/passport-google-oauth20": "^2.0.16",
    "body-parser": "^1.20.2",
    "cookie-parser": "^1.4.6",
    "date-fns": "^3.6.0",
    "express": "^4.18.2",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^7.1.4",
    "express-session": "^1.18.0",
    "googleapis": "^128.0.0",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.11.7",
    "lodash": "^4.17.21",
    "memorystore": "^1.6.7",
    "nanoid": "^5.0.7",
    "nodemailer": "^6.9.7",
    "passport": "^0.7.0",
    "passport-google-oauth2": "^0.2.0",
    "passport-google-oauth20": "^2.0.0",
    "prisma": "^5.6.0",
    "supertest": "^6.3.3",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "winston-slack-webhook-transport": "^2.3.3"
  }
}