generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int       @id @default(autoincrement())
  publicId    String    @unique @map("public_id")
  email       String    @unique
  type        String    @map("type")
  firstName   String    @map("first_name")
  lastName    String    @map("last_name")
  phoneNumber String?   @map("phone_number")
  address     String?   @map("address")
  active      Boolean
  password    String?   @map("password")
  createdAt   DateTime  @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")

  UserToken UserToken[]
  Project   Project[]

  @@index([publicId, email])
  @@map(name: "user")
}

model UserToken {
  id       Int    @id @default(autoincrement())
  publicId String @unique @map("public_id")
  token    String
  userId   Int    @map("user_id")

  meta      Json?
  expiredAt DateTime @map("expired_at")
  createdAt DateTime @default(now()) @map("created_at")

  User User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([token, userId])
  @@index([userId, token])
  @@map(name: "user_token")
}

model Project {
  id       Int    @id @default(autoincrement())
  publicId String @unique @map("public_id")
  name     String

  sid    String @unique
  authId String @unique @map("auth_id")

  planId  Int @map("plan_id")
  userId  Int @map("user_id")
  balance Int

  Plan    Plan      @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  User    User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  Service Service[]

  createdAt    DateTime       @default(now()) @map("created_at")
  deletedAt    DateTime?      @map("deleted_at")
  Subscription Subscription[]

  @@index([sid, publicId])
  @@map(name: "project")
}

model Subscription {
  id        Int    @id @default(autoincrement())
  publicId  String @unique @map("public_id")
  projectId Int    @map("project_id")
  planId    Int    @map("plan_id")
  expired   Int    @map("expired") // Month

  paymentAt DateTime @map("payment_at")
  createdAt DateTime @default(now()) @map("created_at")

  Project Project @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  Plan    Plan    @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([publicId, projectId])
  @@map(name: "subscription")
}

model Plan {
  id              Int            @id @default(autoincrement())
  publicId        String         @unique @map("public_id")
  name            String
  messageCommited Int?           @map("message_commited")
  pricing         String?
  Project         Project[]
  Subscription    Subscription[]

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([publicId])
  @@map(name: "plan")
}

model Service {
  id        Int    @id @default(autoincrement())
  publicId  String @unique @map("public_id")
  sid       String @unique
  projectId Int    @map("project_id")

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  Project Project @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([sid, publicId])
  @@map(name: "service")
}

model Pricing {
  id       Int    @id @default(autoincrement())
  publicId String @unique @map("public_id")
  chanel   String

  countryName String @map("country_name")
  countryCode String @map("country_code")

  carrierCode String @map("carrier_code")
  carrierName String @map("carrier_name")

  base       Int
  free       Int
  standard   Int
  bussiness  Int
  enterprise Int

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([countryCode, carrierCode, chanel, publicId])
  @@map(name: "pricing")
}

model AuthRequest {
  id       Int    @id @default(autoincrement())
  publicId String @unique @map("public_id")
  userId   Int    @map("user_id")
  type     String // verify || reset
  limit    Int    @default(0)

  updatedAt DateTime  @default(now()) @map("updated_at")
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([userId, publicId])
  @@map(name: "auth_request")
}
